local function clickOrderedItems(groups)
    local tradingGui = playerGui:FindFirstChild("Trading")
    if not tradingGui then return 0 end
    local frame = tradingGui:FindFirstChild("Frame")
    if not frame then return 0 end
    local main = frame:FindFirstChild("Main")
    if not main then return 0 end
    local yourOffer = main:FindFirstChild("YourOffer")
    if not yourOffer then return 0 end
    local itemDisplay = yourOffer:FindFirstChild("ItemDisplay")
    if not itemDisplay then return 0 end
    local scrollingFrame = itemDisplay:FindFirstChild("ScrollingFrame")
    if not scrollingFrame then return 0 end
    
    local buttons = {}
    local function collect()
        for _, btn in ipairs(scrollingFrame:GetChildren()) do
            if btn:IsA("ImageButton") and btn.Visible and buttons[btn.Name] == nil then
                buttons[btn.Name] = btn
            end
        end
    end
    
    scrollingFrame.CanvasPosition = Vector2.new(0, 0)
    task.wait(0.05)
    collect()
    local maxScroll = scrollingFrame.CanvasSize.Y.Offset - scrollingFrame.AbsoluteWindowSize.Y
    if maxScroll > 0 then
        scrollingFrame.CanvasPosition = Vector2.new(0, maxScroll)
        task.wait(0.05)
        collect()
    end
    
    local clicked = 0
    local usedButtons = {}
    
    for _, group in ipairs(groups) do
        for _, entry in ipairs(group) do
            local btn = buttons[entry.name] or buttons[entry.name .. "::None"]
            if not btn then
                local target = entry.name:lower()
                for btnName, b in pairs(buttons) do
                    if btnName:lower() == target then
                        btn = b
                        break
                    end
                end
                if not btn then
                    for btnName, b in pairs(buttons) do
                        local bn = btnName:lower()
                        if #bn > 2 and (bn:find(target, 1, true) or target:find(bn, 1, true)) then
                            btn = b
                            break
                        end
                    end
                end
            end
            if btn and not usedButtons[btn] then
                usedButtons[btn] = true
                if safeClick(btn) then
                    clicked = clicked + 1
                    task.wait(0.03)
                end
            end
        end
    end
    
    return clicked
end

