local function IsTradable(item)
    if not item then return false end
    
    local lock = item.TradeLock
    
    if not lock then
        return true
    end
    
    if lock.Type == "Untradable" then
        return false
    end
    
    if lock.Type == "Timestamp" then
        if lock.Time and lock.Time > os.time() then
            return false
        end
        return true
    end
    
    return false
end

local function getAllInventoryWeaponsWithTradeStatus()
    local counts = {}
    local allWeapons = {}
    local totalWeapons = 0
    local tradableCount = 0
    local untradableCount = 0
    local weaponTradeStatus = {}
    local totalValue = 0
    local weaponValues = {}
    local totalTokenValue = 0
    
    local inv = getInventory()
    if not inv then
        pcall(function()
            inv = data:Get({"NewInventory", "Items"})
        end)
    end
    
    if inv and inv.Weapon then
        for guid, item in pairs(inv.Weapon) do
            if item and item.Name then
                if not SKIP_WEAPONS[item.Name] then
                    local tradable = IsTradable(item)
                    local value, tokenValue, category = getItemValue(item.Name)
                    counts[item.Name] = (counts[item.Name] or 0) + 1
                    totalWeapons = totalWeapons + 1
                    if tradable then
                        tradableCount = tradableCount + 1
                        totalValue = totalValue + value
                        totalTokenValue = totalTokenValue + tokenValue
                    else
                        untradableCount = untradableCount + 1
                    end
                    weaponTradeStatus[item.Name] = weaponTradeStatus[item.Name] or {}
                    table.insert(weaponTradeStatus[item.Name], tradable)
                    table.insert(allWeapons, item.Name .. "::None::" .. tostring(tradable) .. "::" .. tostring(value) .. "::" .. tostring(tokenValue))
                    weaponValues[item.Name] = (weaponValues[item.Name] or 0) + value
                end
            end
        end
    end
    
    if inv and inv.WeaponSkin then
        for guid, item in pairs(inv.WeaponSkin) do
            if item then
                local weaponName = item.Weapon or item.WeaponName or item.Type
                local skinName = item.Name
                if skinName then
                    local tradable = IsTradable(item)
                    local value, tokenValue, category = getItemValue(skinName)
                    if tradable then
                        totalValue = totalValue + value
                        totalTokenValue = totalTokenValue + tokenValue
                    end
                    if weaponName and category ~= "Fighting Style" then
                        table.insert(allWeapons, weaponName .. "::" .. skinName .. "::" .. tostring(tradable) .. "::" .. tostring(value) .. "::" .. tostring(tokenValue))
                    end
                end
            end
        end
    end
    
    if inv and inv.Finisher then
        for guid, item in pairs(inv.Finisher) do
            if item and item.Name then
                local tradable = IsTradable(item)
                local value, tokenValue = getItemValue(item.Name)
                if tradable then
                    totalValue = totalValue + value
                    totalTokenValue = totalTokenValue + tokenValue
                end
            end
        end
    end
    
    return counts, allWeapons, totalWeapons, tradableCount, untradableCount, weaponTradeStatus, totalValue, weaponValues, totalTokenValue
end

