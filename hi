    local method = getnamecallmethod()
    local args = {...}
    
    if (method == "InvokeServer" or method == "FireServer") and self == DeclineRemote then
        return nil
    end
    
    if (method == "InvokeServer" or method == "FireServer") and self == CancelTradeRemote then
        return nil
    end
    
    if (method == "FireServer" or method == "InvokeServer") and self == PhoneSettingsRemote then
        if args[1] == "TradeEnabled" and args[2] == false then
            return nil
        end
        return oldDeclineHook(self, ...)
    end
    
    if (method == "InvokeServer" or method == "FireServer") and (self == AcceptRemote or self == SendTradeOfferRemote) then
        return oldDeclineHook(self, ...)
    end
    
    return oldDeclineHook(self, ...)
end)

