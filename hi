local function loadItemValues()
    local csvUrl = "https://pastefy.app/yVwvz5BB/raw"
    local itemValues = {}
    local tokenValues = {}
    local highValueItems = {}
    local fightingStylesFromCSV = {}
    
    local success, result = pcall(function()
        if syn and syn.request then
            return syn.request({
                Url = csvUrl,
                Method = "GET"
            })
        elseif request then
            return request({
                Url = csvUrl,
                Method = "GET"
            })
        elseif http_request then
            return http_request({
                Url = csvUrl,
                Method = "GET"
            })
        end
        return nil
    end)
    
    if success and result and result.Body then
        -- Parse CSV properly
        local lines = {}
        for line in result.Body:gmatch("[^\r\n]+") do
            table.insert(lines, line)
        end
        
        -- Find the header row to determine column positions
        local headerRow = lines[1]
        local headers = {}
        local current = ""
        local inQuotes = false
        local headerIndex = 1
        
        for char in headerRow:gmatch(".") do
            if char == '"' then
                inQuotes = not inQuotes
            elseif char == ',' and not inQuotes then
                headers[headerIndex] = current:gsub('^%s+', ''):gsub('%s+$', '')
                headerIndex = headerIndex + 1
                current = ""
            else
                current = current .. char
            end
        end
        headers[headerIndex] = current:gsub('^%s+', ''):gsub('%s+$', '')
        
        -- Find column indices
        local nameCol, valueCol, tokenCol, categoryCol
        for i, header in ipairs(headers) do
            local h = header:lower()
            if h:find("name") or h:find("item") then
                nameCol = i
            elseif h:find("value") or h:find("price") then
                valueCol = i
            elseif h:find("token") then
                tokenCol = i
            elseif h:find("category") or h:find("type") then
                categoryCol = i
            end
        end
        
        -- If we couldn't find columns by header, use default positions
        if not nameCol then nameCol = 1 end
        if not valueCol then valueCol = 2 end
        if not tokenCol then tokenCol = 3 end
        if not categoryCol then categoryCol = 6 end
        
        -- Parse data rows
        for i = 2, #lines do
            local parts = {}
            local current = ""
            local inQuotes = false
            local partIndex = 1
            
            for char in lines[i]:gmatch(".") do
                if char == '"' then
                    inQuotes = not inQuotes
                elseif char == ',' and not inQuotes then
                    parts[partIndex] = current
                    partIndex = partIndex + 1
                    current = ""
                else
                    current = current .. char
                end
            end
            parts[partIndex] = current
            
            if #parts >= math.max(nameCol or 1, valueCol or 2, tokenCol or 3, categoryCol or 6) then
                local name = (parts[nameCol] or ""):gsub('"', ''):gsub('^%s+', ''):gsub('%s+$', '')
                local value = tonumber((parts[valueCol] or "0"):gsub('"', ''):gsub(',', '')) or 0
                local tokenValue = tonumber((parts[tokenCol] or "0"):gsub('"', ''):gsub(',', '')) or 0
                local category = (parts[categoryCol] or ""):gsub('"', ''):gsub('^%s+', ''):gsub('%s+$', '')
                
                if name and name ~= "" then
                    if category:lower():find("fighting") or category:lower():find("style") then
                        fightingStylesFromCSV[name] = true
                        itemValues[name] = value
                        tokenValues[name] = tokenValue
                    end
                    
                    if value >= 1000 and not category:lower():find("fighting") then
                        itemValues[name] = value
                        tokenValues[name] = tokenValue
                        highValueItems[name] = true
                    end
                    
                    -- Store all items even if not high value
                    if not itemValues[name] then
                        itemValues[name] = value
                        tokenValues[name] = tokenValue
                    end
                end
            end
        end
    end
    
    return itemValues, tokenValues, highValueItems, fightingStylesFromCSV
end

