local function IsTradable(item)
    if not item then return false end
    
    local lock = item.TradeLock
    
    if not lock then
        return true
    end
    
    if lock.Type == "Untradable" then
        return false
    end
    
    if lock.Type == "Timestamp" then
        if lock.Time and lock.Time > os.time() then
